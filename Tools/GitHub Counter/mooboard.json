{
  "format": 3,
  "id": "github-counter",
  "name": "GitHub Counter",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Your GitHub followers, a repo's stars, or your contribution streak. No key needed.",
  "category": "Tools",
  "runtime": "lua54",
  "minFirmware": "0.4.4",
  "boards": ["s3", "p4"],
  "settings": [
    {"key": "user", "type": "text", "label": "GitHub username", "default": "octocat", "max": 39},
    {"key": "show", "type": "choice", "label": "Show", "default": "Followers", "options": ["Followers", "Stars", "Streak"]},
    {"key": "repo", "type": "text", "label": "Repo for stars", "default": "octocat/Hello-World", "max": 100}
  ],
  "controls": [
    {"key": "count", "type": "readout", "label": "Count"}
  ],
  "sources": [
    {"key": "user", "url": "https://api.github.com/users/{settings.user}", "refresh": 900},
    {"key": "repo", "url": "https://api.github.com/search/repositories?q=repo:{settings.repo}&per_page=1", "refresh": 1800},
    {"key": "days", "url": "https://api.mooboard.co/github/{settings.user}", "refresh": 3600}
  ],
  "complications": [
    {"key": "followers", "label": "GitHub followers", "source": "user", "path": "followers"},
    {"key": "stars", "label": "GitHub stars", "source": "repo", "path": "items[0].stargazers_count"}
  ]
}
