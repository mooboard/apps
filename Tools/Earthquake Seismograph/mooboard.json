{
  "format": 2,
  "id": "quake-monitor",
  "name": "Earthquake Seismograph",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Live USGS quake tracker with magnitude badge.",
  "category": "Tools",
  "uses": "scoreboard",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "left",
      "type": "text",
      "label": "Source",
      "default": "USGS",
      "max": 8
    },
    {
      "key": "right",
      "type": "text",
      "label": "Alert",
      "default": "M5.0+",
      "max": 8
    },
    {
      "key": "left_color",
      "type": "color",
      "label": "Badge color",
      "default": "#FF453A"
    },
    {
      "key": "right_color",
      "type": "color",
      "label": "Wave color",
      "default": "#FF9F0A"
    }
  ],
  "controls": [
    {
      "key": "left",
      "type": "stepper",
      "label": "Min Mag",
      "min": 20,
      "max": 90
    },
    {
      "key": "right",
      "type": "stepper",
      "label": "Radius km",
      "min": 1,
      "max": 50
    },
    {
      "key": "reset",
      "type": "button",
      "label": "Reset"
    },
    {
      "key": "done",
      "type": "button",
      "label": "Done"
    }
  ]
}