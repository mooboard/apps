{
  "format": 3,
  "id": "stocks",
  "name": "Stocks",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Your stocks and coins with today's change.",
  "category": "Tools",
  "runtime": "lua54",
  "minFirmware": "0.4.4",
  "boards": [
    "s3",
    "p4"
  ],
  "settings": [
    {
      "key": "key",
      "type": "secret",
      "label": "Finnhub key",
      "max": 64
    },
    {
      "key": "stock1",
      "type": "text",
      "label": "Stock 1",
      "default": "AAPL",
      "max": 12
    },
    {
      "key": "stock2",
      "type": "text",
      "label": "Stock 2",
      "default": "MSFT",
      "max": 12
    },
    {
      "key": "stock3",
      "type": "text",
      "label": "Stock 3",
      "default": "NVDA",
      "max": 12
    },
    {
      "key": "coin1",
      "type": "text",
      "label": "Coin 1",
      "default": "bitcoin",
      "max": 32
    },
    {
      "key": "coin2",
      "type": "text",
      "label": "Coin 2",
      "default": "ethereum",
      "max": 32
    }
  ],
  "controls": [],
  "sources": [
    {
      "key": "s1",
      "url": "https://finnhub.io/api/v1/quote?symbol={settings.stock1}",
      "refresh": 300,
      "headers": {
        "X-Finnhub-Token": "{settings.key}"
      }
    },
    {
      "key": "s2",
      "url": "https://finnhub.io/api/v1/quote?symbol={settings.stock2}",
      "refresh": 300,
      "headers": {
        "X-Finnhub-Token": "{settings.key}"
      }
    },
    {
      "key": "s3",
      "url": "https://finnhub.io/api/v1/quote?symbol={settings.stock3}",
      "refresh": 300,
      "headers": {
        "X-Finnhub-Token": "{settings.key}"
      }
    },
    {
      "key": "coins",
      "url": "https://api.coingecko.com/api/v3/simple/price?ids={settings.coin1},{settings.coin2}&vs_currencies=usd&include_24hr_change=true",
      "refresh": 300
    }
  ],
  "complications": [
    {
      "key": "stock",
      "label": "Stock 1",
      "source": "s1",
      "path": "c",
      "icon": "bar",
      "decimals": 2,
      "change": "dp",
      "size": "small",
      "refresh": 300
    },
    {
      "key": "coin",
      "label": "Coin 1",
      "source": "coins",
      "path": "{settings.coin1}.usd",
      "icon": "bar",
      "decimals": 2,
      "change": "{settings.coin1}.usd_24h_change",
      "size": "small",
      "refresh": 300
    }
  ]
}
