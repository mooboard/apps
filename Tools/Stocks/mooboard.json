{
  "format": 3,
  "id": "stocks",
  "name": "Stocks",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Your stocks and coins with today's change.",
  "category": "Tools",
  "runtime": "lua54",
  "minFirmware": "0.4.4",
  "boards": [
    "s3",
    "p4"
  ],
  "settings": [
    {
      "key": "stock1",
      "type": "text",
      "label": "Stock 1",
      "default": "AAPL",
      "max": 12
    },
    {
      "key": "stock2",
      "type": "text",
      "label": "Stock 2",
      "default": "MSFT",
      "max": 12
    },
    {
      "key": "stock3",
      "type": "text",
      "label": "Stock 3",
      "default": "NVDA",
      "max": 12
    },
    {
      "key": "coin1",
      "type": "text",
      "label": "Coin 1",
      "default": "BTC",
      "max": 12
    },
    {
      "key": "coin2",
      "type": "text",
      "label": "Coin 2",
      "default": "ETH",
      "max": 12
    }
  ],
  "controls": [],
  "sources": [
    {
      "key": "stocks",
      "url": "https://api.mooboard.co/quotes?s={settings.stock1},{settings.stock2},{settings.stock3}",
      "refresh": 300
    },
    {
      "key": "coins",
      "url": "https://api.coingecko.com/api/v3/simple/price?symbols={settings.coin1},{settings.coin2}&vs_currencies=usd&include_24hr_change=true",
      "refresh": 300
    }
  ],
  "complications": [
    {
      "key": "stock",
      "label": "Stock: {settings.stock1}",
      "source": "stocks",
      "path": "q[0].c",
      "icon": "bar",
      "decimals": 2,
      "change": "q[0].dp",
      "size": "small",
      "refresh": 300
    },
    {
      "key": "coin",
      "label": "Coin: {settings.coin1}",
      "source": "coins",
      "path": "{settings.coin1}.usd",
      "icon": "bar",
      "decimals": 2,
      "change": "{settings.coin1}.usd_24h_change",
      "size": "small",
      "refresh": 300
    }
  ]
}
