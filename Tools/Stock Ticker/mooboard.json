{
  "format": 2,
  "id": "stock-ticker",
  "name": "Stock Ticker",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Market watchlist prices, 24h change, and morning brief glance.",
  "category": "Tools",
  "uses": "scoreboard",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "left",
      "type": "text",
      "label": "Symbol 1",
      "default": "BTC",
      "max": 8
    },
    {
      "key": "right",
      "type": "text",
      "label": "Symbol 2",
      "default": "SPY",
      "max": 8
    },
    {
      "key": "left_color",
      "type": "color",
      "label": "Color 1",
      "default": "#34C759"
    },
    {
      "key": "right_color",
      "type": "color",
      "label": "Color 2",
      "default": "#3C9DFF"
    }
  ],
  "controls": [
    {
      "key": "left",
      "type": "stepper",
      "label": "Price 1",
      "min": 0,
      "max": 99999
    },
    {
      "key": "right",
      "type": "stepper",
      "label": "Price 2",
      "min": 0,
      "max": 99999
    },
    {
      "key": "reset",
      "type": "button",
      "label": "Reset"
    },
    {
      "key": "done",
      "type": "button",
      "label": "Done"
    }
  ]
}