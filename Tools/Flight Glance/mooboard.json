{
  "format": 2,
  "id": "flight-glance",
  "name": "Flight Glance",
  "version": "1.2.0",
  "by": "mooboard",
  "description": "Flights, routes and radar. Data: adsb.lol (ODbL).",
  "category": "Tools",
  "uses": "flightglance",
  "minFirmware": "0.4.0",
  "settings": [
    {
      "key": "radius",
      "type": "choice",
      "label": "Nearby radius",
      "default": "15 nm",
      "options": [
        "5 nm",
        "15 nm",
        "30 nm",
        "60 nm",
        "120 nm"
      ]
    },
    {
      "key": "units",
      "type": "choice",
      "label": "Units",
      "default": "Aviation",
      "options": [
        "Aviation",
        "Metric"
      ]
    },
    {
      "key": "follow",
      "type": "text",
      "label": "Follow callsigns 1-3",
      "default": "-",
      "max": 32
    },
    {
      "key": "follow2",
      "type": "text",
      "label": "Follow callsigns 4-5",
      "default": "-",
      "max": 32
    },
    {
      "key": "cycle",
      "type": "choice",
      "label": "Time per aircraft",
      "default": "5 seconds",
      "options": [
        "3 seconds",
        "5 seconds",
        "8 seconds"
      ]
    },
    {
      "key": "layout",
      "type": "choice",
      "label": "Layout",
      "default": "All screens",
      "options": [
        "Details",
        "Radar",
        "All screens",
        "Airline",
        "Route",
        "Progress",
        "Instruments",
        "Flight board"
      ]
    },
    {
      "key": "quiet",
      "type": "choice",
      "label": "When the sky is quiet",
      "default": "Clock",
      "options": [
        "Clock",
        "No flights",
        "Dots",
        "Blank"
      ]
    },
    {
      "key": "title",
      "type": "choice",
      "label": "Flight title",
      "default": "Callsign",
      "options": [
        "Callsign",
        "Tail number"
      ]
    }
  ]
}
