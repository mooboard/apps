{
  "format": 2,
  "id": "flight-glance",
  "name": "Flight Glance",
  "version": "1.1.0",
  "by": "mooboard",
  "description": "Live aircraft, callsigns and flight metrics. Data: adsb.lol (ODbL).",
  "category": "Tools",
  "uses": "flightglance",
  "minFirmware": "0.3.2",
  "settings": [
    {
      "key": "radius",
      "type": "choice",
      "label": "Nearby radius",
      "default": "15 nm",
      "options": [
        "5 nm",
        "15 nm",
        "30 nm",
        "60 nm",
        "120 nm"
      ]
    },
    {
      "key": "units",
      "type": "choice",
      "label": "Units",
      "default": "Aviation",
      "options": [
        "Aviation",
        "Metric"
      ]
    },
    {
      "key": "follow",
      "type": "text",
      "label": "Follow callsigns 1-3",
      "default": "-",
      "max": 32
    },
    {
      "key": "follow2",
      "type": "text",
      "label": "Follow callsigns 4-5",
      "default": "-",
      "max": 32
    },
    {
      "key": "cycle",
      "type": "choice",
      "label": "Time per aircraft",
      "default": "5 seconds",
      "options": [
        "3 seconds",
        "5 seconds",
        "8 seconds"
      ]
    },
    {
      "key": "layout",
      "type": "choice",
      "label": "Layout",
      "default": "Details",
      "options": [
        "Details",
        "Radar"
      ]
    }
  ]
}
