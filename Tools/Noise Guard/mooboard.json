{
  "format": 2,
  "id": "noise-guard",
  "name": "Noise Guard",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Decibel meter monitoring ambient noise.",
  "category": "Tools",
  "uses": "scoreboard",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "left",
      "type": "text",
      "label": "Label",
      "default": "Noise",
      "max": 8
    },
    {
      "key": "right",
      "type": "text",
      "label": "Room",
      "default": "Office",
      "max": 8
    },
    {
      "key": "left_color",
      "type": "color",
      "label": "Meter color",
      "default": "#34C759"
    },
    {
      "key": "right_color",
      "type": "color",
      "label": "Alert color",
      "default": "#FF3B30"
    }
  ],
  "controls": [
    {
      "key": "left",
      "type": "stepper",
      "label": "Current dB",
      "min": 30,
      "max": 120
    },
    {
      "key": "right",
      "type": "stepper",
      "label": "Threshold",
      "min": 40,
      "max": 100
    },
    {
      "key": "reset",
      "type": "button",
      "label": "Reset"
    },
    {
      "key": "done",
      "type": "button",
      "label": "Done"
    }
  ]
}