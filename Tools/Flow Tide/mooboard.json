{
  "format": 2,
  "id": "flow-tide",
  "name": "Flow Tide",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Pomodoro focus tide across 128 pixels from deep blue to tea amber.",
  "category": "Tools",
  "uses": "pomodoro",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "focus",
      "type": "choice",
      "label": "Focus block",
      "default": "25 min",
      "options": [
        "15 min",
        "20 min",
        "25 min",
        "30 min",
        "45 min",
        "50 min"
      ]
    },
    {
      "key": "break",
      "type": "choice",
      "label": "Rest interval",
      "default": "5 min",
      "options": [
        "3 min",
        "5 min",
        "10 min"
      ]
    },
    {
      "key": "long_break",
      "type": "choice",
      "label": "Deep rest cycle",
      "default": "15 min",
      "options": [
        "Off",
        "15 min",
        "20 min",
        "30 min"
      ]
    }
  ],
  "controls": [
    {
      "key": "left",
      "type": "readout",
      "label": "Time remaining"
    },
    {
      "key": "start",
      "type": "button",
      "label": "Start wave"
    },
    {
      "key": "pause",
      "type": "button",
      "label": "Pause wave"
    },
    {
      "key": "resume",
      "type": "button",
      "label": "Resume wave"
    },
    {
      "key": "skip",
      "type": "button",
      "label": "Skip interval"
    },
    {
      "key": "stop",
      "type": "button",
      "label": "End session"
    }
  ]
}
