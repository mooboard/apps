{
  "format": 3,
  "id": "transit",
  "name": "Transit",
  "version": "1.1.0",
  "by": "mooboard",
  "description": "The next bus or train at your stop, from your city's free feed.",
  "category": "Tools",
  "runtime": "lua54",
  "minFirmware": "0.4.4",
  "boards": ["s3", "p4"],
  "settings": [
    {"key": "feed", "type": "text", "label": "Feed link", "default": "none", "max": 256},
    {"key": "name", "type": "text", "label": "Stop name", "default": "My stop", "max": 12},
    {"key": "route", "type": "text", "label": "Route", "default": "all", "max": 16},
    {"key": "heading", "type": "choice", "label": "Direction", "default": "Both", "options": ["Both", "Outbound", "Inbound"]}
  ],
  "controls": [
    {"key": "next", "type": "readout", "label": "Next"}
  ],
  "sources": [
    {"key": "stop", "url": "{settings.feed}", "refresh": 30},
    {"key": "boston", "url": "https://api-v3.mbta.com/predictions?filter[latitude]={place.lat}&filter[longitude]={place.lon}&filter[radius]=0.01&sort=arrival_time&page[limit]=10&fields[prediction]=arrival_time,departure_time,direction_id&include=stop&fields[stop]=name", "refresh": 30, "near": "42.36,-71.06,60"}
  ]
}
