{
  "format": 2,
  "id": "power-grid",
  "name": "Power Grid",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Live solar production, home draw, and grid energy balance.",
  "category": "Tools",
  "uses": "scoreboard",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "left",
      "type": "text",
      "label": "Source name",
      "default": "Solar",
      "max": 8
    },
    {
      "key": "right",
      "type": "text",
      "label": "Load name",
      "default": "Home",
      "max": 8
    },
    {
      "key": "left_color",
      "type": "color",
      "label": "Source color",
      "default": "#FFD000"
    },
    {
      "key": "right_color",
      "type": "color",
      "label": "Load color",
      "default": "#00BFFF"
    }
  ],
  "controls": [
    {
      "key": "left",
      "type": "stepper",
      "label": "Source kW",
      "min": 0,
      "max": 99
    },
    {
      "key": "right",
      "type": "stepper",
      "label": "Load kW",
      "min": 0,
      "max": 99
    },
    {
      "key": "reset",
      "type": "button",
      "label": "Reset meters"
    },
    {
      "key": "done",
      "type": "button",
      "label": "Save levels"
    }
  ]
}
