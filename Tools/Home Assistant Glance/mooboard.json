{
  "format": 2,
  "id": "home-glance",
  "name": "Home Assistant Glance",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Indoor temperature, humidity, and room air quality glance.",
  "category": "Tools",
  "uses": "scoreboard",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "left",
      "type": "text",
      "label": "Room",
      "default": "Living",
      "max": 8
    },
    {
      "key": "right",
      "type": "text",
      "label": "Sensor",
      "default": "Sensor",
      "max": 8
    },
    {
      "key": "left_color",
      "type": "color",
      "label": "Temp color",
      "default": "#34C759"
    },
    {
      "key": "right_color",
      "type": "color",
      "label": "RH color",
      "default": "#00C7BE"
    }
  ],
  "controls": [
    {
      "key": "left",
      "type": "stepper",
      "label": "Temp \u00b0F",
      "min": 0,
      "max": 120
    },
    {
      "key": "right",
      "type": "stepper",
      "label": "Humidity %",
      "min": 0,
      "max": 100
    },
    {
      "key": "reset",
      "type": "button",
      "label": "Reset"
    },
    {
      "key": "done",
      "type": "button",
      "label": "Done"
    }
  ]
}