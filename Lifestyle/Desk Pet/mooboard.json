{
  "format": 2,
  "id": "desk-pet",
  "name": "Desk Pet",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "A tiny pixel buddy that eats, naps, and wanders your board.",
  "category": "Lifestyle",
  "uses": "tally",
  "minFirmware": "0.3.1",
  "settings": [
    {
