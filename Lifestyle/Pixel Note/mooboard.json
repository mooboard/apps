{
  "format": 2,
  "id": "pixel-note",
  "name": "Pixel Note",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Glowing LED board for quick notes.",
  "category": "Lifestyle",
  "uses": "tally",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "label",
      "type": "text",
      "label": "Note Title",
      "default": "Sticky Note",
      "max": 12
    }
  ],
  "controls": [
    {
      "key": "count",
      "type": "stepper",
      "label": "Note ID",
      "min": 0,
      "max": 999
    },
    {
      "key": "add",
      "type": "button",
      "label": "Next Note"
    },
    {
      "key": "reset",
      "type": "button",
      "label": "Clear"
    },
    {
      "key": "done",
      "type": "button",
      "label": "Done"
    }
  ]
}