{
  "format": 3,
  "id": "air-and-uv",
  "name": "Air and UV",
  "version": "1.1.0",
  "by": "mooboard",
  "description": "Air quality and UV index for your place, each in a color for its level.",
  "category": "Lifestyle",
  "runtime": "lua54",
  "minFirmware": "0.4.4",
  "boards": ["s3", "p4"],
  "controls": [
    {"key": "aqi", "type": "readout", "label": "Air quality"},
    {"key": "uv", "type": "readout", "label": "UV index"}
  ],
  "sources": [
    {"key": "air", "url": "https://air-quality-api.open-meteo.com/v1/air-quality?latitude={place.lat}&longitude={place.lon}&current=us_aqi,uv_index", "refresh": 900}
  ],
  "complications": [
    {"key": "aqi", "label": "Air quality", "source": "air", "path": "current.us_aqi", "icon": "bar",
     "levels": [50, "#34c759", 100, "#ffd60a", 150, "#ff9500", 200, "#ff3b30", 300, "#af52de", 500, "#c2185b"]},
    {"key": "uv", "label": "UV index", "source": "air", "path": "current.uv_index", "icon": "bar",
     "levels": [2, "#34c759", 5, "#ffd60a", 7, "#ff9500", 10, "#ff3b30", 99, "#af52de"]}
  ]
}
