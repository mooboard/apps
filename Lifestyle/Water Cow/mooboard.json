{
  "format": 2,
  "id": "water-cow",
  "name": "Water Cow",
  "version": "1.0.0",
  "by": "mooboard",
  "description": "Daily hydration habit companion with cup target and one-tap logging.",
  "category": "Lifestyle",
  "uses": "tally",
  "minFirmware": "0.3.1",
  "settings": [
    {
      "key": "label",
      "type": "text",
      "label": "Goal title",
      "default": "Water cups",
      "max": 12
    }
  ],
  "controls": [
    {
      "key": "count",
      "type": "stepper",
      "label": "Glasses logged",
      "min": 0,
      "max": 20
    },
    {
      "key": "add",
      "type": "button",
      "label": "Drink glass"
    },
    {
      "key": "reset",
      "type": "button",
      "label": "Reset today"
    },
    {
      "key": "done",
      "type": "button",
      "label": "Save count"
    }
  ]
}
