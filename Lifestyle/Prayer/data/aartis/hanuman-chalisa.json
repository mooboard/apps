{"aliases":["Hanuman Chalisa","Shri Hanuman Chalisa","Hanuman Chaleesa","Hanuman Chalisa Fast","Shree Hanuman Chalisa","Jai Hanuman Gyan Gun Sagar","हनुमान चालीसा"],"name":{"en":"Hanuman Chalisa","hi":"हनुमान चालीसा"},"nameG":0,"om":1,"slug":"hanuman-chalisa","texts":["हनुमान चालीसा","ॐ","श्रीगुरु चरन सरोज रज","निज मनु मुकुरु सुधारि","बरनउँ रघुबर बिमल जसु","जो दायकु फल चारि","बुद्धिहीन तनु जानिके","सुमिरौं पवन-कुमार","बल बुधि बिद्या देहु मोहिं","हरहु कलेस बिकार","जय हनुमान ज्ञान गुन सागर","जय कपीस तिहुँ लोक उजागर","राम दूत अतुलित बल धामा","अंजनि-पुत्र पवनसुत नामा","महाबीर बिक्रम बजरंगी","कुमति निवार सुमति के संगी","कंचन बरन बिराज सुबेसा","कानन कुंडल कुंचित केसा","हाथ बज्र औ ध्वजा बिराजै","काँधे मूँज जनेऊ साजै","संकर सुवन केसरीनंदन","तेज प्रताप महा जग बंदन","बिद्यावान गुनी अति चातुर","राम काज करिबे को आतुर","प्रभु चरित्र सुनिबे को रसिया","राम लखन सीता मन बसिया","सूक्ष्म रूप धरि सियहिं दिखावा","बिकट रूप धरि लंक जरावा","भीम रूप धरि असुर सँहारे","रामचंद्र के काज सँवारे","लाय सजीवन लखन जियाये","श्रीरघुबीर हरषि उर लाये","रघुपति कीन्ही बहुत बड़ाई","तुम मम प्रिय भरतहि सम भाई","सहस बदन तुम्हरो जस गावैं","अस कहि श्रीपति कंठ लगावैं","सनकादिक ब्रह्मादि मुनीसा","नारद सारद सहित अहीसा","जम कुबेर दिगपाल जहाँ ते","कबि कोबिद कहि सके कहाँ ते","तुम उपकार सुग्रीवहिं कीन्हा","राम मिलाय राज पद दीन्हा","तुम्हरो मंत्र बिभीषन माना","लंकेस्वर भए सब जग जाना","जुग सहस्र जोजन पर भानू","लील्यो ताहि मधुर फल जानू","प्रभु मुद्रिका मेलि मुख माहीं","जलधि लाँघि गये अचरज नाहीं","दुर्गम काज जगत के जेते","सुगम अनुग्रह तुम्हरे तेते","राम दुआरे तुम रखवारे","होत न आज्ञा बिनु पैसारे","सब सुख लहै तुम्हारी सरना","तुम रच्छक काहू को डर ना","आपन तेज सम्हारो आपै","तीनों लोक हाँक तें काँपै","भूत पिसाच निकट नहिं आवै","महाबीर जब नाम सुनावै","नासै रोग हरै सब पीरा","जपत निरंतर हनुमत बीरा","संकट तें हनुमान छुड़ावै","मन क्रम बचन ध्यान जो लावै","सब पर राम तपस्वी राजा","तिन के काज सकल तुम साजा","और मनोरथ जो कोई लावै","सोइ अमित जीवन फल पावै","चारों जुग परताप तुम्हारा","है परसिद्ध जगत उजियारा","साधु संत के तुम रखवारे","असुर निकंदन राम दुलारे","अष्ट सिद्धि नौ निधि के दाता","अस बर दीन जानकी माता","राम रसायन तुम्हरे पासा","सदा रहो रघुपति के दासा","तुम्हरे भजन राम को पावै","जनम जनम के दुख बिसरावै","अंतकाल रघुबर पुर जाई","जहाँ जन्म हरि-भक्त कहाई","और देवता चित्त न धरई","हनुमत सेइ सर्ब सुख करई","संकट कटै मिटै सब पीरा","जो सुमिरै हनुमत बलबीरा","जय जय जय हनुमान गोसाईं","कृपा करहु गुरुदेव की नाईं","जो सत बार पाठ कर कोई","छूटहि बंदि महा सुख होई","जो यह पढ़ै हनुमान चालीसा","होय सिद्धि साखी गौरीसा","तुलसीदास सदा हरि चेरा","कीजै नाथ हृदय महँ डेरा","पवन तनय संकट हरन","मंगल मूरति रूप","राम लखन सीता सहित","हृदय बसहु सुर भूप"],"verses":[[{"en":"Shri-guru charan saroj raj","g":2,"hi":"श्रीगुरु चरन सरोज रज"},{"en":"Nij manu mukuru sudhari","g":3,"hi":"निज मनु मुकुरु सुधारि"},{"en":"Barnaun Raghubar bimal jasu","g":4,"hi":"बरनउँ रघुबर बिमल जसु"},{"en":"Jo dayaku phal chari","g":5,"hi":"जो दायकु फल चारि"}],[{"en":"Buddhiheen tanu janike","g":6,"hi":"बुद्धिहीन तनु जानिके"},{"en":"Sumiraun Pavan-kumar","g":7,"hi":"सुमिरौं पवन-कुमार"},{"en":"Bal budhi bidya dehu mohin","g":8,"hi":"बल बुधि बिद्या देहु मोहिं"},{"en":"Harahu kales bikar","g":9,"hi":"हरहु कलेस बिकार"}],[{"en":"Jai Hanuman gyan gun sagar","g":10,"hi":"जय हनुमान ज्ञान गुन सागर"},{"en":"Jai Kapis tihun lok ujagar","g":11,"hi":"जय कपीस तिहुँ लोक उजागर"},{"en":"Ram doot atulit bal dhama","g":12,"hi":"राम दूत अतुलित बल धामा"},{"en":"Anjani-putra Pavansut nama","g":13,"hi":"अंजनि-पुत्र पवनसुत नामा"}],[{"en":"Mahabir bikram Bajrangi","g":14,"hi":"महाबीर बिक्रम बजरंगी"},{"en":"Kumati nivar sumati ke sangi","g":15,"hi":"कुमति निवार सुमति के संगी"},{"en":"Kanchan baran biraj subesa","g":16,"hi":"कंचन बरन बिराज सुबेसा"},{"en":"Kanan kundal kunchit kesa","g":17,"hi":"कानन कुंडल कुंचित केसा"}],[{"en":"Haath bajra au dhwaja biraje","g":18,"hi":"हाथ बज्र औ ध्वजा बिराजै"},{"en":"Kandhe moonj janeu saje","g":19,"hi":"काँधे मूँज जनेऊ साजै"},{"en":"Sankar suvan Kesari-nandan","g":20,"hi":"संकर सुवन केसरीनंदन"},{"en":"Tej pratap maha jag bandan","g":21,"hi":"तेज प्रता